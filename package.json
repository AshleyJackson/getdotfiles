{
  "name": "getdotfiles",
  "version": "0.0.1-pre5",
  "description": "Fetch dotfiles from a GitHub user's dotfiles repo and install them to your home directory",
  "type": "module",
  "bin": {
    "getdotfiles": "./dist/getdotfiles.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./bin/getdotfiles.js --target=node --outfile=./dist/getdotfiles.js",
    "prepublishOnly": "npm run build && npm run check",
    "prepack": "node -e \"require('fs').chmodSync('dist/getdotfiles.js', 0o755)\"",
    "check": "node --check dist/getdotfiles.js",
    "test": "node --check dist/getdotfiles.js",
    "dry-run": "bun run build && node dist/getdotfiles.js",
    "dev": "node bin/getdotfiles.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshleyJackson/getdotfiles.git"
  },
  "keywords": ["dotfiles", "cli", "github", "dotenv"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}