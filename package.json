{
  "name": "getdotfiles",
  "version": "0.0.2",
  "description": "Fetch dotfiles from a GitHub user's dotfiles repo and install them to your home directory",
  "type": "module",
  "bin": {
    "getdotfiles": "./dist/getdotfiles.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./bin/getdotfiles.ts --target=node --outfile=./dist/getdotfiles.js",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build && bun run check && bun test",
    "prepack": "node -e \"require('fs').chmodSync('dist/getdotfiles.js', 0o755)\"",
    "check": "node --check dist/getdotfiles.js",
    "test": "bun test",
    "dry-run": "bun run build && node dist/getdotfiles.js",
    "dev": "bun run bin/getdotfiles.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AshleyJackson/getdotfiles.git"
  },
  "keywords": [
    "dotfiles",
    "cli",
    "github",
    "windows",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
